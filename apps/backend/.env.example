# Copy to .env for local development. Never commit the real .env file.

# --- App ---
NODE_ENV=development
PORT=3001

# --- Database (matches docker-compose.yml at repo root) ---
DATABASE_URL="postgresql://village_app:village_dev_password@localhost:5432/village_security?schema=public"

# --- Auth cross-tenant phone lookup (see infra/postgres/init/01-init.sql and
# auth.service.ts) --- a second, narrowly-scoped BYPASSRLS role used ONLY to
# resolve which village a phone number belongs to during login, before
# village_id is known. Column-grant restricted to id/village_id/phone/role/
# house_id/name on `users` only — cannot read password_hash or any other
# table. Never use this connection string for anything else.
AUTH_LOOKUP_DATABASE_URL="postgresql://village_app_auth_lookup:village_dev_auth_lookup_password@localhost:5432/village_security?schema=public"

# --- Auth JWT (session token issued after OTP verification) ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Visitor QR token (separate signing key from auth JWT, see ARCHITECTURE.md) ---
QR_TOKEN_SECRET="change-me-qr-secret"

# --- OTP provider (stub/mock in dev; wire a real SMS gateway before staging) ---
OTP_PROVIDER="mock"
OTP_TTL_SECONDS=300

# --- File storage (S3-compatible; see ARCHITECTURE.md for bucket split) ---
S3_ENDPOINT=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_ENTRY_LOGS="village-entry-logs"
S3_BUCKET_SENSITIVE_ID="village-sensitive-id-photos"
S3_BUCKET_AVATARS="village-avatars"

# --- Push (Expo Push Notification Service — see docs/ARCHITECTURE.md
# ADR-006 for why Expo Push instead of raw FCM. Optional: Expo's push
# service works without this for Expo Go / this project's current scale;
# only needed for Expo's enhanced-security push API. Not FCM/APNs
# credentials — Expo's own infrastructure manages those. ---
EXPO_ACCESS_TOKEN=""
