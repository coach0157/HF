{
  "expo": {
    "name": "Village Security",
    "slug": "village-mobile",
    "scheme": "villagesecurity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.villagesecurity.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "ใช้กล้องเพื่อสแกน QR แขก และถ่ายรูปบัตรประชาชน/ทะเบียนรถ (เฉพาะ รปภ.)",
        "NSLocationWhenInUseUsageDescription": "ใช้พิกัดเพื่อแนบตำแหน่งเมื่อกดปุ่ม SOS"
      }
    },
    "android": {
      "package": "app.villagesecurity.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ใช้กล้องเพื่อสแกน QR แขก และถ่ายรูปบัตรประชาชน/ทะเบียนรถ (เฉพาะ รปภ.)"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ใช้คลังรูปภาพเพื่อแนบรูปในแชท",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3001",
      "eas": {
        "projectId": "8236b3ac-1d62-40a3-baca-ac2e3888cc48"
      }
    },
    "owner": "coach0157"
  }
}
