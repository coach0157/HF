# Copy to .env.local for local development (gitignored).
#
# Expo inlines any EXPO_PUBLIC_-prefixed var into the JS bundle at build time.
# `localhost` only works from an iOS simulator or when Metro forwards ports
# for you — a physical phone (Expo Go or an installed build) must use your
# dev machine's LAN IP instead, since "localhost" on the phone means the
# phone itself. Find your IP with `ipconfig` (Windows) and make sure the
# phone is on the same Wi-Fi network as this machine.
EXPO_PUBLIC_API_BASE_URL="http://192.168.1.104:3001"
